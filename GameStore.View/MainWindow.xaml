<local:BaseView x:Class="GameStore.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameStore.View"
        mc:Ignorable="d"
        Title="Магазин Игр (MVVM)" Height="500" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <ListView Grid.Column="0" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="30"/>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="140"/>
                    <GridViewColumn Header="Жанр" DisplayMemberBinding="{Binding Genre}" Width="90"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding Price}" Width="70"/>
                    <GridViewColumn Header="Скидка %" DisplayMemberBinding="{Binding DiscountPercentage}" Width="70"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Column="1" Margin="10" Background="#F0F0F0">
            <TextBlock Text="ДАННЫЕ ИГРЫ" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>

            <Label Content="Название:"/>
            <TextBox Text="{Binding InputTitle, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Жанр:"/>
            <TextBox Text="{Binding InputGenre, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Цена (руб):"/>
            <TextBox Text="{Binding InputPrice, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Скидка (%):"/>
            <TextBox Text="{Binding InputDiscount, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Orientation="Vertical" Margin="0,20,0,0">
                <Button Content="Добавить игру" Command="{Binding AddCommand}" Margin="0,5" Height="30"/>
                <Button Content="Удалить выбранную" Command="{Binding DeleteCommand}" Margin="0,5" Height="30" Background="#FFCCCC"/>

                <Separator Margin="0,10"/>

                <Button Content="Игры со скидкой" Command="{Binding ShowDiscountedCommand}" Margin="0,5"/>
                <Button Content="Сгруппировать по жанру" Command="{Binding GroupByGenreCommand}" Margin="0,5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:BaseView>